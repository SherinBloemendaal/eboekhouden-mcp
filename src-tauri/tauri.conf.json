{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EB MCP",
  "version": "0.6.1",
  "identifier": "dev.sherin.ebmcp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run sparkle && npm run bridge:dev && npm run dev",
    "beforeBuildCommand": "npm run sparkle && npm run bridge && npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "EB MCP",
        "url": "index.html#/dashboard",
        "width": 1240,
        "height": 780,
        "minWidth": 980,
        "minHeight": 620,
        "visible": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 22,
          "y": 26
        },
        "windowEffects": {
          "effects": [
            "sidebar",
            "mica"
          ],
          "state": "followsWindowActiveState"
        }
      },
      {
        "label": "panel",
        "title": "EB MCP",
        "url": "index.html#/panel",
        "width": 336,
        "height": 540,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "popover",
            "acrylic"
          ],
          "state": "active",
          "radius": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "externalBin": [
      "binaries/eb-mcp-bridge"
    ]
  }
}
